# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Dataset (never commit raw/processed images)
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.bmp
data/**/*.tif
data/**/*.tiff
data/**/*.npy
data/**/*.npz
data/**/*.csv
!data/README.md

# Model checkpoints
models/**/*.pth
models/**/*.pt
models/**/*.onnx
models/**/*.ckpt
!models/README.md

# Results (generated artifacts, not source)
results/**/*.png
results/**/*.csv
results/**/*.json
!results/README.md

# Streamlit / app runtime
app/assets/*
!app/assets/.gitkeep

# Environment / secrets
.env
.env.*
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
