# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Dataset (never commit raw/processed images)
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.bmp
data/**/*.tif
data/**/*.tiff
data/**/*.npy
data/**/*.npz
data/**/*.csv
!data/README.md
# The real dataset is referenced, never copied: data/original/<name> is a
# symlink to the read-only local dataset. Only the placeholder is tracked.
data/original/*
!data/original/.gitkeep
# The frozen split manifest and its hash are committed on purpose.
!data/split_manifest.csv
!data/split_manifest.sha256

# Model checkpoints
models/**/*.pth
models/**/*.pt
models/**/*.onnx
models/**/*.ckpt
!models/README.md

# Results (generated artifacts, not source)
results/**/*.png
results/**/*.csv
results/**/*.json
!results/README.md
# Dataset audit outputs are committed: they document the frozen split.
!results/data_audit.csv
!results/data_audit_report.md
# Experiment records are committed (small, reproducibility); weights are not.
results/**/*.pth
results/**/*.pt
!results/experiments/**/config.json
!results/experiments/**/metrics.csv
!results/experiments/**/experiment_report.md
!results/experiments/**/inference_benchmark.json
!results/experiments/**/eval_val/metrics.json
!results/experiments/**/training_curves.png
!results/experiments/**/confusion_matrix.png
!results/experiments/**/confusion_matrix_normalized.png
# Top-level comparison tables (paper matrix, gate comparisons, final results).
!results/*.csv
!results/final/*.json
!results/final/*.csv
!results/final/*.md

# Streamlit / app runtime
app/assets/*
!app/assets/.gitkeep

# Environment / secrets
.env
.env.*
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
