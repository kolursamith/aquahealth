# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Dataset (never commit raw/processed images)
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.bmp
data/**/*.tif
data/**/*.tiff
data/**/*.npy
data/**/*.npz
data/**/*.csv
!data/README.md
# The real dataset is referenced, never copied: data/original/<name> is a
# symlink to the read-only local dataset. Only the placeholder is tracked.
data/original/*
!data/original/.gitkeep
# The frozen split manifest and its hash are committed on purpose.
!data/split_manifest.csv
!data/split_manifest.sha256
# Phase-2 raw datasets: data/raw/<key> are symlinks into the delivery drop
# (scripts/link_raw_datasets.py); only the README is tracked.
data/raw/*
!data/raw/README.md
# Phase-2 audit outputs (inventory, label mapping, master manifest, duplicate
# report) are committed: they document the combined dataset, like data_audit.csv.
!data/audit/*.csv
!data/audit/*.md
!data/audit/**/*.csv
!data/audit/**/*.md
!data/audit/**/*.sha256
# data/combined_v2 is reserved; images never go into git.
!data/combined_v2/README.md

# Model checkpoints
models/**/*.pth
models/**/*.pt
models/**/*.onnx
models/**/*.ckpt
!models/README.md

# Results (generated artifacts, not source)
results/**/*.png
results/**/*.csv
results/**/*.json
!results/README.md
# Dataset audit outputs are committed: they document the frozen split.
!results/data_audit.csv
!results/data_audit_report.md
# Experiment records are committed (small, reproducibility); weights are not.
results/**/*.pth
results/**/*.pt
!results/experiments/**/config.json
!results/experiments/**/metrics.csv
!results/experiments/**/experiment_report.md
!results/experiments/**/inference_benchmark.json
!results/experiments/**/eval_val/metrics.json
!results/experiments/**/training_curves.png
!results/experiments/**/confusion_matrix.png
!results/experiments/**/confusion_matrix_normalized.png
# Top-level comparison tables (paper matrix, gate comparisons, final results).
!results/*.csv
!results/final/*.json
!results/final/*.csv
!results/final/*.md
# Phase-12 CV experiments (results/v2): the matrix and each experiment's small records
# are committed; checkpoints (*.pt) and logs are not.
!results/v2/*.csv
!results/v2/experiments/**/config.json
!results/v2/experiments/**/history.csv
!results/v2/experiments/**/metrics.json
!results/v2/experiments/**/confusion_matrix.csv
!results/v2/experiments/**/run_summary.json
!results/v2/experiments/**/status.json
# Phase-10 GAN registry (one line per fold: architecture, seed, counts, digests) is tracked;
# the images, checkpoints and per-fold manifests under data/gan/ are not.
!results/v2/gan/registry.csv
# Layer 3 GAN records (per-image provenance, verification report, generation summary, console log)
!results/v2/gan/GAN_MANIFEST.csv
!results/v2/gan/verification.json
!results/v2/gan/generation_summary.json
!results/v2/gan/*.log
results/v2/smoke/
# Official one-shot test evaluation (Gate 8): every artifact is evidence.
!results/final_test/*.json
!results/final_test/*.csv
!results/final_test/*.md
!results/final_test/*.txt
!results/final_test/*.png

# Streamlit / app runtime
app/assets/*
!app/assets/.gitkeep

# Environment / secrets
.env
.env.*
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Local copy of Google Drive experiment outputs (checkpoints, zip); never committed.
drive_export/

# GAN outputs (checkpoints, synthetic images, per-fold manifests): generated, never committed.
data/gan/

# Layer 2: a Colab bundle built inside the repository by mistake is never committed.
aquahealth_bundle*/
*.tar

# Quarantined unofficial GAN outputs (v2 data / local MPS): never committed, never used.
data/gan_archive_unofficial/
!results/v2/drive_delivery.json

# Phase 12 GPU migration: large archives (GAN tar.gz, Drive/Colab exports, results zips) and
# Colab scratch never enter git; their locations and digests are documented in
# docs/PHASE12_GPU_MIGRATION.md.
*.tar.gz
*.tgz
*.zip
sample_data/
